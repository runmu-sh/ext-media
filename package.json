{
  "name": "@runmu.sh/ext-media",
  "version": "1.0.0",
  "description": "The Media panel: what is playing (music and sounds, each with Stop), the master volume and mute, and the images the game showed, from GMCP Client.Media, MSP and MXP <image>.",
  "keywords": [
    "media",
    "sound",
    "music",
    "images",
    "gmcp",
    "msp",
    "mxp",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-media.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-media/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.7.1",
    "@runmu.sh/dev": "^0.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "muclient": {
    "id": "media",
    "api": "^1.7",
    "source": "src/index.ts",
    "displayName": "Media",
    "description": "The Media panel: what is playing with a Stop per track, the master volume and mute, and the images the game showed.",
    "categories": [
      "interface",
      "sound"
    ],
    "contributes": {
      "panels": [
        {
          "id": "media",
          "title": "Media",
          "defaultPosition": "right-top",
          "order": 30
        }
      ]
    },
    "capabilities": [
      "read-output"
    ],
    "publisher": "bitmuse"
  }
}
